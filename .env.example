# Copy to .env.local and fill in. .env.local is git-ignored; this file is not,
# so never put a real token here.

# ---- Clover ----
# Business Operations -> API tokens in the Clover dashboard (needs 2FA enabled).
VITE_CLOVER_MERCHANT_ID=
CLOVER_API_BASE=https://apisandbox.dev.clover.com

# Can tokenize a card but not charge one. Safe in the browser bundle.
VITE_CLOVER_PUBLIC_TOKEN=

# Creates orders and charges cards. NO VITE_ PREFIX — Vite inlines every VITE_*
# variable into the bundle, and this one must never leave the server.
CLOVER_PRIVATE_TOKEN=

# The server refuses to start against a non-sandbox host without this, so a
# stray edit cannot start billing real cards.
CLOVER_ALLOW_PRODUCTION=

# ---- Printing ----
# Which printer the kitchen ticket goes to. Optional: the server reads the
# merchant's printer list and picks one on its own, preferring an order or
# kitchen printer and falling back to whatever exists. Set it to remove the
# guesswork on a merchant with more than one station.
# This merchant has exactly one — the Station's built-in roll, type MY_LOCAL.
CLOVER_PRINTER_UUID=ZVZ9PRJ255V90

# ---- Guards (set these before hosting the proxy anywhere) ----
# Ships in the browser bundle, so it is NOT a secret — it turns away drive-by
# scanners and nothing more. With it unset the proxy serves localhost only and
# refuses remote callers outright.
APP_KEY=
VITE_APP_KEY=

# Comma-separated. Browsers enforce this and a page on another domain cannot
# spoof it, which is why it is one of the guards that actually holds.
ALLOWED_ORIGINS=

# Ceiling on any single charge.
MAX_CHARGE_DOLLARS=500

PORT=3001
